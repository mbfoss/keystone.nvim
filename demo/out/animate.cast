[2.278207, "o", ".filter(buf) else return true end     \u001b[24;9Hend                                                                         \u001b[25;9Hreturn false\u001b[26;5Hend             \u001b[27;5H   \u001b[28;5H--- Determines the amount of scrollable lines between two window views,\u001b[29;9Htaking folds and virtual lines into account.                       \u001b[30;8H@param from vim.fn.winsaveview.ret           \u001b[31;15Hto vim.fn.winsaveview.ret  \u001b[32;5Hlocal function _scroll_lines(win, from, to)\u001b[33;5H    if from.topline == to.topline then     \u001b[34;9H    return math.abs(from.topfill - to.topfill)\u001b[35;9Hend                                           \u001b[36;9Hif to.topline < from.topline then\u001b[37;9H    from, to = to, from          \u001b[38;9Hend                    \u001b[10;5H\u001b[?25h"]

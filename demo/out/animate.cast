[1.571207, "o", " from vim.fn.winsaveview.ret           \u001b[32;3H\u001b(B\u001b[m\u001b[38;2;160;162;173m\u001b[48;2;46;47;51m3 \u001b(B\u001b[m\u001b[38;2;242;242;245m\u001b[48;2;46;47;51m---@param to vim.fn.winsaveview.ret  \u001b[33;3H\u001b(B\u001b[m\u001b[38;2;160;162;173m\u001b[48;2;46;47;51m4 \u001b(B\u001b[m\u001b[38;2;242;242;245m\u001b[48;2;46;47;51mlocal function _scroll_lines(win, from, to)\u001b[34;3H\u001b(B\u001b[m\u001b[38;2;160;162;173m\u001b[48;2;46;47;51m5 \u001b(B\u001b[m\u001b[38;2;242;242;245m\u001b[48;2;46;47;51m    if from.topline == to.topline then     \u001b[35;3H\u001b(B\u001b[m\u001b[38;2;160;162;173m\u001b[48;2;46;47;51m6 \u001b(B\u001b[m\u001b[38;2;242;242;245m\u001b[48;2;46;47;51m        return math.abs(from.topfill - to.topfill)\u001b[36;3H\u001b(B\u001b[m\u001b[38;2;160;162;173m\u001b[48;2;46;47;51m7 \u001b(B\u001b[m\u001b[38;2;242;242;245m\u001b[48;2;46;47;51m    end                                           \u001b[37;3H\u001b(B\u001b[m\u001b[38;2;160;162;173m\u001b[48;2;46;47;51m8 \u001b(B\u001b[m\u001b[38;2;242;242;245m\u001b[48;2;46;47;51m    if to.topline < from.topline then\u001b[38;2H\u001b(B\u001b[m\u001b[38;2;160;162;173m\u001b[48;2;46;47;51m29 \u001b(B\u001b[m\u001b[38;2;242;242;245m\u001b[48;2;46;47;51m        from, to = to, from          \u001b[9;5H\u001b[?25h"]
[1.615253, "o", "\u001b[?25l\u001b[2;15Hstep number? Frame interval in milliseconds (default: 16)                     \u001b[3;5H                                                                   \u001b[4;5H---@type keystone.animate.Config\u001b[5;5Hlocal _default_config = {       \u001b[6;5H    enabled = true,      \u001b[7;9Hfilter = nil,  \u001b[8;9Heasing\u001b[9;2H\u001b(B\u001b[m\u001b[38;2;236;236;244m\u001b[48;2;58;59;65m5  \u001b(B\u001b[m\u001b[38;2;242;242;245m\u001b[48;2;58;59;65m    speed = 20,  \u001b[10;9H\u001b(B\u001b[m\u001b[38;2;242;242;245m\u001b[48;2;46;47;51mduration = 300,\u001b[11;9Hstep = 16,     \u001b[12;5H}             \u001b[13;5H \u001b[14;5H---@type keystone.animate.Config\u001b[15;5HM.config = vim.deepcopy(_default_config)\u001b[16;5H                                        \u001b[17;5Hlocal function _keycode(str)\u001b[18;5H    return vim.api.nvim_replace_termcodes(str, true, false, true)\u001b[19;5Hend                                                              \u001b[20;5H   \u001b[21;5Hlocal function _filter(buf)\u001b[22;5H    if vim.b[buf].keystone_scroll ~= false and vim.bo[buf].buftype ~= \"terminal\" then\u001b[23;9H    if M.config.filter then return M.config"]
[1.617643, "o", ".filter(buf) else return true end     \u001b[24;9Hend                                                                         \u001b[25;9Hreturn false\u001b[26;5Hend             \u001b[27;5H   \u001b[28;5H--- Determines the amount of scrollable lines between two window views,\u001b[29;9Htaking folds and virtual lines into account.                       \u001b[30;8H@param from vim.fn.winsaveview.ret           \u001b[31;15Hto vim.fn.winsaveview.ret  \u001b[32;5Hlocal function _scroll_lines(win, from, to)\u001b[33;5H    if from.topline == to.topline then     \u001b[34;9H    return math.abs(from.topfill - to.topfill)\u001b[35;9Hend                                           \u001b[36;9Hif to.topline < from.topline then\u001b[37;9H    from, to = to, from          \u001b[38;9Hend                    \u001b[9;5H\u001b[?25h"]

[0.00467, "o", "\u001b[?25l\u001b[H\u001b[2J\u001b(B\u001b[m\u001b[38;2;242;242;245m\u001b[48;2;58;59;65m                                                                                                                        \r\n\u001b(B\u001b[m\u001b[38;2;236;236;244m\u001b[48;2;58;59;65m1   \u001b(B\u001b[m\u001b[38;2;242;242;245m\u001b[48;2;58;59;65m--- The clue engine. Each configured trigger is a `nowait` keymap that, when                                        \r\n\u001b(B\u001b[m\u001b[38;2;160;162;173m\u001b[48;2;46;47;51m  1 \u001b(B\u001b[m\u001b[38;2;242;242;245m\u001b[48;2;46;47;51m--- pressed, runs a synchronous loop: read the next key with `getcharstr`, descend\r\n\u001b(B\u001b[m\u001b[38;2;160;162;173m\u001b[48;2;46;47;51m  2 \u001b(B\u001b[m\u001b[38;2;242;242;245m\u001b[48;2;46;47;51m--- the tree (showing the popup after a delay), and once a leaf or unknown key is\r\n\u001b(B\u001b[m\u001b[38;2;160;162;173m\u001b[48;2;46;47;51m  3 \u001b(B\u001b[m\u001b[38;2;242;242;245m\u001b[48;2;46;47;51m--- reached, re-feed the resolved sequence so the real mapping / builtin runs\r\n\u001b(B\u001b[m\u001b[38;2;160;162;173m\u001b[48;2;46;47;51m  4 \u001b(B\u001b[m\u001b[38;2;242;242;245m\u001b[48;2;46;47;51m--- natively (preserving counts, registers, operators "]
[0.007345, "o", "and dot-repeat).\r\n\u001b(B\u001b[m\u001b[38;2;160;162;173m\u001b[48;2;46;47;51m  5 \u001b(B\u001b[m\u001b[38;2;242;242;245m\u001b[48;2;46;47;51m---\r\n\u001b(B\u001b[m\u001b[38;2;160;162;173m\u001b[48;2;46;47;51m  6 \u001b(B\u001b[m\u001b[38;2;242;242;245m\u001b[48;2;46;47;51m--- Triggers are registered both globally and, on `BufEnter`/`LspAttach`, as\r\n\u001b(B\u001b[m\u001b[38;2;160;162;173m\u001b[48;2;46;47;51m  7 \u001b(B\u001b[m\u001b[38;2;242;242;245m\u001b[48;2;46;47;51m--- buffer-local `nowait` shadows. The buffer-local copy is essential: `nowait`\r\n\u001b(B\u001b[m\u001b[38;2;160;162;173m\u001b[48;2;46;47;51m  8 \u001b(B\u001b[m\u001b[38;2;242;242;245m\u001b[48;2;46;47;51m--- on a *global* mapping does not stop Neovim from waiting out `timeoutlen` when\r\n\u001b(B\u001b[m\u001b[38;2;160;162;173m\u001b[48;2;46;47;51m  9 \u001b(B\u001b[m\u001b[38;2;242;242;245m\u001b[48;2;46;47;51m--- a buffer-local mapping shares the trigger as a prefix (e.g. LSP's `gd`/`gr`).\r\n\u001b(B\u001b[m\u001b[38;2;160;162;173m\u001b[48;2;46;47;51m 10 \u001b(B\u001b[m\u001b[38;2;242;242;245m\u001b[48;2;46;47;51m--- A buffer-local `nowait` full match suppresses that wait, so the popup fires\r\n\u001b(B\u001b[m\u001b[38;2;160;162;173m\u001b[48;2;46;47;51m 11 \u001b(B\u001b[m\u001b[38;2;242;242;245m\u001b[48;2;46"]
[0.00947, "o", ";47;51m--- immediately instead of stalling in operator-pending.\r\n\u001b(B\u001b[m\u001b[38;2;160;162;173m\u001b[48;2;46;47;51m 12 \u001b(B\u001b[m\u001b[38;2;242;242;245m\u001b[48;2;46;47;51mlocal Keys = require(\"keystone.clue.keys\")\r\n\u001b(B\u001b[m\u001b[38;2;160;162;173m\u001b[48;2;46;47;51m 13 \u001b(B\u001b[m\u001b[38;2;242;242;245m\u001b[48;2;46;47;51mlocal Tree = require(\"keystone.clue.tree\")\r\n\u001b(B\u001b[m\u001b[38;2;160;162;173m\u001b[48;2;46;47;51m 14 \u001b(B\u001b[m\u001b[38;2;242;242;245m\u001b[48;2;46;47;51mlocal config = require(\"keystone.clue.config\").current\r\n\u001b(B\u001b[m\u001b[38;2;160;162;173m\u001b[48;2;46;47;51m 15 \r\n 16 \u001b(B\u001b[m\u001b[38;2;242;242;245m\u001b[48;2;46;47;51mlocal uv = vim.uv or vim.loop\r\n\u001b(B\u001b[m\u001b[38;2;160;162;173m\u001b[48;2;46;47;51m 17 \r\n 18 \u001b(B\u001b[m\u001b[38;2;242;242;245m\u001b[48;2;46;47;51mlocal M = {}\r\n\u001b(B\u001b[m\u001b[38;2;160;162;173m\u001b[48;2;46;47;51m 19 \r\n 20 \u001b(B\u001b[m\u001b[38;2;242;242;245m\u001b[48;2;46;47;51m---@type { mode: string, lhs: string }[]\r\n\u001b(B\u001b[m\u001b[38;2;160;162;173m\u001b[48;2;46;47;51m 21 \u001b(B\u001b[m\u001b[38;2;242;242;245m\u001b[48;2;46;47;51mM._registered = {}\r\n\u001b(B\u001b[m\u001b[38;2;160;162;173m\u001b[48;2;46;47;51m 22 \u001b(B\u001b[m\u001b[38;2;242;242;245m\u001b[48;2;46;47;51m--"]
[0.011758, "o", "-@type table<integer, { mode: string, lhs: string }[]>\r\n\u001b(B\u001b[m\u001b[38;2;160;162;173m\u001b[48;2;46;47;51m 23 \u001b(B\u001b[m\u001b[38;2;242;242;245m\u001b[48;2;46;47;51mM._buf_registered = {}\r\n\u001b(B\u001b[m\u001b[38;2;160;162;173m\u001b[48;2;46;47;51m 24 \u001b(B\u001b[m\u001b[38;2;242;242;245m\u001b[48;2;46;47;51m---@type keystone.clue.Trigger[]\r\n\u001b(B\u001b[m\u001b[38;2;160;162;173m\u001b[48;2;46;47;51m 25 \u001b(B\u001b[m\u001b[38;2;242;242;245m\u001b[48;2;46;47;51mM._triggers = {}\r\n\u001b(B\u001b[m\u001b[38;2;160;162;173m\u001b[48;2;46;47;51m 26 \u001b(B\u001b[m\u001b[38;2;242;242;245m\u001b[48;2;46;47;51mM._active = false\r\n\u001b(B\u001b[m\u001b[38;2;160;162;173m\u001b[48;2;46;47;51m 27 \u001b(B\u001b[m\u001b[38;2;242;242;245m\u001b[48;2;46;47;51mM._augroup = nil\r\n\u001b(B\u001b[m\u001b[38;2;160;162;173m\u001b[48;2;46;47;51m 28 \r\n 29 \u001b(B\u001b[m\u001b[38;2;242;242;245m\u001b[48;2;46;47;51m--- Resolve the live mode to a mapmode letter (n/x/o/i/c/...).\r\n\u001b(B\u001b[m\u001b[38;2;160;162;173m\u001b[48;2;46;47;51m 30 \u001b(B\u001b[m\u001b[38;2;242;242;245m\u001b[48;2;46;47;51m---@return string\r\n\u001b(B\u001b[m\u001b[38;2;160;162;173m\u001b[48;2;46;47;51m 31 \u001b(B\u001b[m\u001b[38;2;242;242;245m\u001b[48;2;46;47;51mlocal function _mapmode()\r\n\u001b(B\u001b[m\u001b[38;2;160;162;173m\u001b[48;2;46;47;51m 32 \u001b(B\u001b[m"]
